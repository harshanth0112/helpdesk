# ============================================================
# Backend Production Environment Variables
# Copy this file conceptually; set these in Render's dashboard.
# NEVER commit actual values to version control.
# ============================================================

ENVIRONMENT=production
DEBUG=False

# ---- Database (Railway PostgreSQL) -------------------------
# Paste the full Railway connection string here.
# Railway may provide postgres:// — the app config normalises it to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME

# ---- JWT Authentication ------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_min_64_hex_chars

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Password Reset ----------------------------------------
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ---- CORS / Frontend ---------------------------------------
# Use the exact Render static-site URL — no trailing slash.
FRONTEND_URL=https://YOUR-FRONTEND.onrender.com
ALLOWED_ORIGINS=https://YOUR-FRONTEND.onrender.com
