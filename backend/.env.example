# Backend Environment Variables — copy to .env and fill in real values
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Explicit CORS Origins (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_helpdesk
DB_USER=helpdesk_app
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

# JWT Authentication — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_min_32_chars_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend URL (used in email links for password reset)
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# n8n Cloud Gmail Email Automation
# Set both variables to enable email dispatch via the n8n workflow.
# Leave blank to disable email sending (all other features still work).
# ----------------------------------------------------------------------------
# Production webhook URL (activate workflow in n8n Cloud, then copy Production URL):
N8N_EMAIL_WEBHOOK_URL=https://harsha0112.app.n8n.cloud/webhook/helpdesk/send-email
# Shared secret — must match the X-Helpdesk-Secret value set in n8n Header Auth credential:
N8N_EMAIL_WEBHOOK_SECRET=CHANGE_ME_long_random_secret
# Sender display name shown in emails:
EMAIL_SENDER_NAME=Smart IT Helpdesk
# HTTP timeout (seconds) for the webhook call:
EMAIL_TIMEOUT_SECONDS=10
