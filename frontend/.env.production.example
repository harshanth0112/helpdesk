# ============================================================
# Frontend Production Environment Variables
# Set these in Render's Static Site dashboard (Environment tab).
# Vite bakes these into the JS bundle at build time — NEVER put
# secrets, DB credentials, or JWT keys here.
# ============================================================

# Full URL to the deployed Render backend — no trailing slash.
VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
